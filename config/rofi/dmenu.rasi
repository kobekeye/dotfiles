configuration {
    font: "JetBrainsMono Nerd 12";

    /* networkmanager-dmenu 本身已經安排好項目順序，
       不建議讓 rofi 再自己排序 */
    sort: false;

    matching: "fuzzy";

    /* 滑鼠到底不要 wrap 回最上面 */
    cycle: false;


    scroll-method: 1;
    hover-select: true;
    me-select-entry: "";
    me-accept-entry: "MousePrimary";
}

* {
    /* Lago di Braies / Waybar-inspired palette */
    bg:              rgba(242, 238, 228, 0.94);
    bg-soft:         rgba(255, 255, 255, 0.30);

    fg:              #334347;
    fg-muted:        #7c8583;

    selected-bg:     rgba(111, 188, 187, 0.22);
    selected-fg:     #243d40;

    border-color:    rgba(255, 255, 255, 0.55);

    scrollbar-bg:    rgba(50, 65, 67, 0.08);
    scrollbar-handle:#829693;

    background-color: transparent;
    text-color: @fg;
}

/* ─────────────────────────────
 * Window
 * ───────────────────────────── */

window {
    location: center;
    anchor: center;

    width: 50%;

    background-color: @bg;

    border: 1px;
    border-color: @border-color;
    border-radius: 16px;

    padding: 10px;
}

/* ─────────────────────────────
 * Overall layout
 * ───────────────────────────── */

mainbox {
    spacing: 6px;
    background-color: transparent;

    children: [
        inputbar,
        listview
    ];
}

/* ─────────────────────────────
 * Search bar
 * ───────────────────────────── */

inputbar {
    background-color: @bg-soft;

    border: 0px;
    border-radius: 11px;

    padding: 10px 14px;
    spacing: 8px;

    children: [
        prompt,
        entry,
        num-filtered-rows,
        textbox-num-sep,
        num-rows
    ];
}

prompt {
    background-color: transparent;
    text-color: @fg;

    padding: 0px;
}

entry {
    background-color: transparent;
    text-color: @fg;

    placeholder: "Type to filter…";
    placeholder-color: @fg-muted;

    padding: 0px;
}

num-filtered-rows {
    background-color: transparent;
    text-color: @fg-muted;
}

textbox-num-sep {
    background-color: transparent;
    text-color: @fg-muted;

    str: "/";
}

num-rows {
    background-color: transparent;
    text-color: @fg-muted;
}

/* ─────────────────────────────
 * Results
 * ───────────────────────────── */

listview {
    background-color: transparent;

    columns: 1;
    lines: 12;

    spacing: 2px;

    scrollbar: true;

    border: 0px;
    padding: 2px;

    fixed-height: true;
}

/* 每一個 network / action */

element {
    background-color: transparent;

    border: 0px;
    border-radius: 9px;

    padding: 8px 10px;
    spacing: 8px;
}

/*
 * networkmanager-dmenu / rofi 可能把奇偶列標成
 * normal 與 alternate，所以兩者強制使用同樣背景，
 * 把你現在畫面中的 zebra stripes 拿掉。
 */

element normal.normal {
    background-color: transparent;
    text-color: @fg;
}

element alternate.normal {
    background-color: transparent;
    text-color: @fg;
}

element normal.active {
    background-color: transparent;
    text-color: @fg;
}

element alternate.active {
    background-color: transparent;
    text-color: @fg;
}

/* selected item */

element selected.normal {
    background-color: @selected-bg;
    text-color: @selected-fg;
}

element selected.active {
    background-color: @selected-bg;
    text-color: @selected-fg;
}

element-text {
    background-color: transparent;
    text-color: inherit;

    vertical-align: 0.5;
}

/* ─────────────────────────────
 * Scrollbar
 * ───────────────────────────── */

scrollbar {
    background-color: @scrollbar-bg;

    width: 4px;

    border: 0px;
    border-radius: 8px;

    handle-color: @scrollbar-handle;

    padding: 0px;
}
