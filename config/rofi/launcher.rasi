configuration {
    modi: "drun";
    show-icons: true;
    display-drun: "";
    drun-display-format: "{name}";
    disable-history: false;
    click-to-exit: true;
    scroll-method: 1;
    cycle: false;
hover-select: false;
me-select-entry: "MousePrimary";
me-accept-entry: "!MousePrimary";
}

* {
    font: "Geist Regular 12";

    /* warm neutral palette */
    bg:              rgba(33, 31, 29, 0.88);
    bg-soft:         rgba(255, 255, 255, 0.06);
    bg-hover:        rgba(255, 255, 255, 0.08);
    // bg:             #211f1dd6;
    // bg-soft:        #ffffff0f;
    // bg-hover:       #ffffff14;

    fg:             #eee9e2ff;
    fg-muted:       #aaa49cff;

    border:         #f2e8da24;
    selected-bg:    #eadbc516;
    selected-border:#f0dfc62b;
    selected-fg:    #f7f2ebff;

    background-color: transparent;
    text-color: @fg;
}

window {
    width: 40%;
    location: center;
    anchor: center;

    padding: 12px;

    background-color: @bg;

    border: 1px;
    border-color: @border;
    border-radius: 18px;
}

mainbox {
    spacing: 10px;
    background-color: transparent;
}

/* Search bar */
inputbar {
    padding: 10px 13px;
    spacing: 8px;

    background-color: @bg-soft;

    border: 1px;
    border-color: #ffffff0d;
    border-radius: 12px;

    children: [ prompt, entry ];
}

prompt {
    enabled: true;
    text-color: @fg-muted;
    background-color: transparent;
}

entry {
    placeholder: "Search";
    placeholder-color: @fg-muted;

    text-color: @fg;
    background-color: transparent;
}

/* Results */
listview {
    lines: 7;
    columns: 1;

    spacing: 3px;
    padding: 0px;
    border: 0px;

    fixed-height: true;
    scrollbar: false;

    background-color: transparent;
}

element {
    padding: 9px 11px;
    spacing: 10px;

    border: 1px;
    border-color: transparent;
    border-radius: 11px;

    background-color: transparent;
    text-color: @fg;
}

element normal.normal {
    background-color: transparent;
    text-color: @fg;
}

element alternate.normal {
    background-color: transparent;
    text-color: @fg;
}

element selected.normal {
    background-color: @selected-bg;
    text-color: @selected-fg;

    border: 1px;
    border-color: @selected-border;
}
// element-text selected.normal {
//     text-transform: strikethrough;
// }
// element-text {
//     font: inherit;
// }

element-icon {
    size: 26px;
    margin: 0px 3px 0px 0px;

    background-color: transparent;
}

element-text {
    vertical-align: 0.5;
    background-color: transparent;
    text-color: inherit;
}
